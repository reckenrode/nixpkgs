diff --git a/lib/Nixpkgs/Hardening.cpp b/lib/Nixpkgs/Hardening.cpp
new file mode 100644
index 0000000000..52e973391f
--- /dev/null
+++ b/lib/Nixpkgs/Hardening.cpp
@@ -0,0 +1,315 @@ static std::vector<std::string> getNixHardeningVars(const std::string& suffixSal
+// SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
+
+// This (more or less) duplicates the logic of `pkgs/build-support/cc-wrapper/add-hardening.sh`.
+// Why? We don’t wrap Swift. We also want to support per-target hardening, so that we don’t need
+// to rebuild Swift to harden different targets. `-target <triple>` should do the right thing.
+
+#include "swift/Nixpkgs/Hardening.h"
+
+#include "llvm/Support/Process.h"
+
+#include <format>
+#include <functional>
+#include <iostream>
+#include <map>
+#include <mutex>
+#include <unordered_map>
+#include <unordered_set>
+
+using llvm::sys::Process;
+
+std::once_flag NixDebugFlag;
+int NixDebugLevel;
+
+std::map<std::pair<std::string, bool>, std::pair<std::vector<std::string>, std::vector<std::string>>> NixHardeningFlagsCache;
+
+const std::string NIX_HARDENING_ENABLE_VAR{"NIX_HARDENING_ENABLE"};
+const std::string NIX_CC_WRAPPER_TARGET_VAR{"NIX_CC_WRAPPER_TARGET"};
+
+using ApplyHardeningFunction = std::function<void(std::vector<std::string>&, std::vector<std::string>&, const llvm::Triple&, bool)>;
+
+const std::unordered_map<std::string, ApplyHardeningFunction> AllHardeningFlags{
+  {"format", [](auto&, auto& flagsAfter, const auto&, auto) {
+    flagsAfter.emplace_back("-Wformat");
+    flagsAfter.emplace_back("-Wformat-security");
+    flagsAfter.emplace_back("-Werror=format-security");
+  }},
+  {"fortify", [](auto& flagsBefore, auto& flagsAfter, const auto&, auto) {
+    // fortify flags require special handling to avoid clashing with compiler- and user-provided flags.
+    flagsBefore.emplace_back("-O2");
+    flagsBefore.emplace_back("-U_FORTIFY_SOURCE");
+    flagsBefore.emplace_back("-D_FORTIFY_SOURCE=2");
+    flagsAfter.emplace_back("-U_FORTIFY_SOURCE");
+  }},
+  {"fortify3", [](auto& flagsBefore, auto& flagsAfter, const auto&, auto) {
+    // fortify flags require special handling to avoid clashing with compiler- and user-provided flags.
+    flagsBefore.emplace_back("-O2");
+    flagsBefore.emplace_back("-U_FORTIFY_SOURCE");
+    flagsBefore.emplace_back("-D_FORTIFY_SOURCE=3");
+    flagsAfter.emplace_back("-U_FORTIFY_SOURCE");
+  }},
+  {"glibcxxassertions", [](auto&, auto& flagsAfter, const auto&, auto) {
+    flagsAfter.emplace_back("-D_GLIBCXX_ASSERTIONS");
+  }},
+  {"libcxxhardeningextensive", [](auto&, auto& flagsAfter, const auto&, auto) {
+    flagsAfter.emplace_back("-D_LIBCPP_HARDENING_MODE=_LIBCPP_HARDENING_MODE_EXTENSIVE");
+  }},
+  {"libcxxhardeningfast", [](auto&, auto& flagsAfter, const auto&, auto) {
+    flagsAfter.emplace_back("-D_LIBCPP_HARDENING_MODE=_LIBCPP_HARDENING_MODE_FAST");
+  }},
+  {"nostrictaliasing", [](auto&, auto& flagsAfter, const auto&, auto) {
+    flagsAfter.emplace_back("-fno-strict-aliasing");
+  }},
+  {"shadowstack", [](auto&, auto& flagsAfter, const auto&, auto) {
+    flagsAfter.emplace_back("-fcf-protection=return");
+  }},
+  {"stackclashprotection", [](auto&, auto& flagsAfter, const auto&, auto) {
+    flagsAfter.emplace_back("-fstack-clash-protection");
+  }},
+  {"strictflexarrays1", [](auto&, auto& flagsAfter, const auto&, auto) {
+    flagsAfter.emplace_back("-fstrict-flex-arrays=1");
+  }},
+  {"strictflexarrays3", [](auto&, auto& flagsAfter, const auto&, auto) {
+    flagsAfter.emplace_back("-fstrict-flex-arrays=3");
+  }},
+  {"strictoverflow", [](auto&, auto& flagsAfter, const auto&, auto) {
+    flagsAfter.emplace_back("-fwrapv");
+  }},
+  {"trivialautovarinit", [](auto&, auto& flagsAfter, const auto&, auto) {
+    flagsAfter.emplace_back("-ftrivial-auto-var-init=pattern");
+  }},
+  {"zerocallusedregs", [](auto&, auto& flagsAfter, const auto&, auto) {
+    flagsAfter.emplace_back("-fzero-call-used-regs=used-gpr");
+  }},
+// These require special handling depending on whether or not they’re being passed to `clang` or `clang -cc1`
+// because the parameters are different. CC1 parameters based on how Clang or LLVM interpret the driver parameters.
+  {"pacret", [](auto&, auto& flagsAfter, const auto&, auto isCC1) {
+    if (isCC1) {
+      // Per `ARM::parseBranchProtection` in llvm/lib/TargetParser/ARMTargetParserCommon.cpp
+      // and `CollectARMPACBTIOptions` in clang/lib/Driver/ToolChains/Clang.cpp.
+      flagsAfter.emplace_back("-msign-return-address=non-leaf");
+      flagsAfter.emplace_back("-msign-return-address-key=a_key");
+      flagsAfter.emplace_back("-mbranch-target-enforce");
+    } else {
+      flagsAfter.emplace_back("-mbranch-protection=pac-ret");
+    }
+  }},
+  {"pic", [](auto&, auto& flagsAfter, const auto& triple, auto isCC1) {
+    if (isCC1) {
+      // PIC options depend onthe target.
+      // Per `Clang::ConstructJob` in clang/lib/Driver/ToolChains/Clang.cpp.
+      // and `ParsePICArgs` in clang/lib/Driver/ToolChains/CommonArgs.cpp.
+      flagsAfter.emplace_back("-mrelocation-model");
+      flagsAfter.emplace_back("pic");
+      flagsAfter.emplace_back("-pic-level");
+      flagsAfter.emplace_back("2"); // No platforms we support are anything other than level 2.
+      if (triple.isOSDarwin()) flagsAfter.emplace_back("-pic-is-pie");
+    } else {
+      flagsAfter.emplace_back("-fPIC");
+    }
+  }},
+  {"stackprotector", [](auto&, auto& flagsAfter, const auto&, auto isCC1) {
+    if (isCC1) {
+      // Per `RenderSSPOptions` in clang/lib/Driver/ToolChains/Clang.cpp.
+      flagsAfter.emplace_back("-stack-protector");
+      flagsAfter.emplace_back("2" /* strong */);
+      flagsAfter.emplace_back("-stack-protector-buffer-size");
+      flagsAfter.emplace_back("4");
+    } else {
+      flagsAfter.emplace_back("-fstack-protector-strong");
+      flagsAfter.emplace_back("--param");
+      flagsAfter.emplace_back("ssp-buffer-size=4");
+    }
+  }},
+};
+
+// Since we dynamically determine flags based on the target platform, we have to duplicate these values
+// from Nixpkgs. They were obtained from (for each supported platform by suffix salt):
+//     llvmPackages.stdenv.cc.cc.hardeningUnsupportedFlagsByTargetPlatform stdenv.hostPlatform
+// Exceptions:
+// - `fortify` is unsupported on Linux because it causes ambiguous symbol errors when importing the SwiftGlibc module.
+const std::unordered_map<std::string, std::vector<std::string>> UnsupportedHardeningFlags{
+  {"arm64_apple_darwin",        {"fortify3", "pacret", "shadowstack", "stackclashprotection"}},
+  {"aarch64_unknown_linux_gnu", {"fortify", "shadowstack"}},
+  {"x86_64_unknown_linux_gnu",  {"fortify", "pacret"}},
+};
+
+// The second flag in the pair implies the first.
+constexpr std::array ImpliedFlagPairs{
+  std::pair{"fortify", "fortify3"},
+  std::pair{"strictflexarrays1", "strictflexarrays3"},
+  std::pair{"libcxxhardeningfast", "libcxxhardeningextensive"},
+};
+
+static std::vector<std::string> getNixHardeningVars(const std::string& suffixSalt) {
+  // We don’t know statically what target we are, and we don’t want to do that because
+  // it would require rebuilding Swift depending on the target. Instead, check for the
+  // triple-specific variable and perform the mangling ourselves to check to find which
+  // target variable(s) are also applicable.
+
+  // Example: arm64-apple-darwin
+  // Default hardening flags:
+  // - format
+  // - fortify
+  // - libcxxhardeningfast
+  // - pic
+  // - stackprotector
+  // - strictflexarrays1
+  // - strictoverflow
+  // - zerocallusedregs
+  //
+  // If the user also sets `NIX_HARDENING_ENABLE_arm64_apple_darwin=libcxxhardeningextensive,
+  // the flags returned will be:
+  // - format
+  // - fortify
+  // - libcxxhardeningextensive
+  // - libcxxhardeningfast
+  // - pic
+  // - stackprotector
+  // - strictflexarrays1
+  // - strictoverflow
+  // - zerocallusedregs
+  //
+  // Note that mutually exclusive flags will be sorted out later (meaning `libcxxhardeningfast`)
+  // will be dropped in favor of `libcxxhardeningextensive`.
+
+  std::vector<std::string> result{std::format("{}_{}", NIX_HARDENING_ENABLE_VAR, suffixSalt)};
+
+  const std::array nixCCWrapperVars{
+    std::pair{std::format("{}_BUILD_{}", NIX_CC_WRAPPER_TARGET_VAR, suffixSalt), "_FOR_BUILD"},
+    std::pair{std::format("{}_HOST_{}", NIX_CC_WRAPPER_TARGET_VAR, suffixSalt), ""},
+    std::pair{std::format("{}_TARGET_{}", NIX_CC_WRAPPER_TARGET_VAR, suffixSalt), "_FOR_TARGET"},
+  };
+
+  for (const auto& [wrapperVar, targetSuffix] : nixCCWrapperVars) {
+    if (auto val = Process::GetEnv(wrapperVar.c_str()); val && *val == "1") {
+      result.emplace_back(std::format("{}{}", NIX_HARDENING_ENABLE_VAR, targetSuffix));
+    }
+  }
+
+  return result;
+}
+
+static std::unordered_set<std::string_view> parseFlagsFromString(const std::string& str) {
+  std::unordered_set<std::string_view> result;
+
+  std::string_view unparsed = str;
+  unparsed.remove_prefix(std::min(unparsed.find_first_not_of(" "), unparsed.size()));
+
+  for (std::size_t pos; (pos = unparsed.find(" ")) != std::string_view::npos; ) {
+    std::size_t startPos = unparsed.find_first_not_of(" ");
+    if (startPos < pos) {
+      auto flag = unparsed.substr(startPos, pos);
+      result.emplace(flag);
+    }
+    unparsed.remove_prefix(pos + 1);
+  }
+  if (unparsed.size() > 0) {
+    result.emplace(unparsed);
+  }
+
+  return result;
+}
+
+static std::unordered_set<std::string> getHardeningFlagsForTarget(const std::string& suffixSalt) {
+  std::unordered_set<std::string> result;
+
+  for (auto const& hardeningVar : getNixHardeningVars(suffixSalt)) {
+    if (auto rawFlags = Process::GetEnv(hardeningVar.c_str())) {
+      auto parsedFlags = parseFlagsFromString(*rawFlags);
+      result.insert(begin(parsedFlags), end(parsedFlags));
+    }
+  }
+  
+  return result;
+}
+
+static std::string getSuffixSalt(const llvm::Triple& triple) {
+  // Nixpkgs uses `arm64-apple-darwin` as the triple for Darwin instead of `arm64-apple-macosx<version>`.
+  auto suffixSalt = triple.isOSDarwin() ? triple.getArchName().str() + "-apple-darwin" : triple.getTriple();
+  replace_if(begin(suffixSalt), end(suffixSalt), [](auto& ch){ return ch == '.' || ch == '-'; }, '_');
+  return suffixSalt;
+}
+
+// Based on `cc-wrapper/add-hardening.sh`
+std::pair<std::vector<std::string>, std::vector<std::string>> getClangImporterHardeningFlagsForTarget(const llvm::Triple& triple,
+                                                                                                      bool isCC1) {
+  static std::mutex nixHardeningFlagsCacheMutex;
+  std::lock_guard guard{nixHardeningFlagsCacheMutex};
+
+  std::call_once(NixDebugFlag, []() {
+    int debugLevel = 0;
+    if (auto nixDebugLevel = Process::GetEnv("NIX_DEBUG")) {
+      // Can’t use `std::stoi` because it throws exceptions, which are disabled in the Swift build.
+      debugLevel = std::atoi(nixDebugLevel->c_str());
+    }
+    // Negative debug levels are invalid. Treat them as 0.
+    NixDebugLevel = std::max(0, debugLevel);
+  });
+
+  auto suffixSalt = getSuffixSalt(triple);
+  
+  const auto [flagsIterator, didInsert] = NixHardeningFlagsCache.insert({std::pair{suffixSalt, isCC1}, {}});
+  auto& hardeningFlagsBefore = flagsIterator->second.first;
+  auto& hardeningFlagsAfter = flagsIterator->second.second;
+
+  if (didInsert) {
+    auto hardeningFlags = getHardeningFlagsForTarget(suffixSalt);
+
+    // Set the implied flag explicitly to make filtering unsupported flags easier.
+    for (const auto& [fst, snd] : ImpliedFlagPairs) {
+      if (hardeningFlags.count(snd) != 0) {
+        hardeningFlags.emplace(fst);
+      }
+    }
+    
+    // Remove unsupported flags including ones that imply the flag because they are also not supported.
+    if (auto it = UnsupportedHardeningFlags.find(suffixSalt.c_str()); it != end(UnsupportedHardeningFlags)) {
+      for (const auto& unsupportedFlag : it->second) {
+        if (auto it = hardeningFlags.find(unsupportedFlag); it != end(hardeningFlags)) {
+          hardeningFlags.erase(it);
+        }
+        for (const auto& [fst, snd] : ImpliedFlagPairs) {
+          if (auto it = hardeningFlags.find(snd); unsupportedFlag == fst && it != end(hardeningFlags)) {
+            hardeningFlags.erase(it);
+          }
+        }
+      }
+    }
+    
+    // Make the pair mutually exclusive because the second implies the first.
+    for (const auto& [fst, snd] : ImpliedFlagPairs) {
+      if (auto it = hardeningFlags.find(fst); hardeningFlags.count(snd) != 0 && it != end(hardeningFlags)) {
+        hardeningFlags.erase(it);
+      }
+    }
+    
+    if (NixDebugLevel >= 1) {
+      std::unordered_set<std::string> disabledFlags;
+      for (const auto& [flag, _ignored] : AllHardeningFlags) {
+        if (hardeningFlags.count(flag) == 0) {
+          disabledFlags.emplace(flag);
+        }
+      }
+
+      std::cerr << "HARDENING: disabled flags:";
+      for (const auto& disabledFlag : disabledFlags) {
+        std::cerr << " " << disabledFlag;
+      }
+      std::cerr << std::endl;
+      
+      std::cerr << "HARDENING: Is active (not completely disabled with \"all\" flag)" << std::endl;
+    }
+
+    for (const auto& flag : hardeningFlags) {
+      if (auto it = AllHardeningFlags.find(flag); it != end(AllHardeningFlags)) {
+        if (NixDebugLevel >= 1) {
+          std::cerr << "HARDENING: enabling " << flag << std::endl;
+        }
+        it->second(hardeningFlagsBefore, hardeningFlagsAfter, triple, isCC1);
+      }
+    }
+  }
+
+  return {hardeningFlagsBefore, hardeningFlagsAfter};
+}
