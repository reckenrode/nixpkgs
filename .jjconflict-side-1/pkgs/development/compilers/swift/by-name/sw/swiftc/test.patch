new file mode 100644
index 0000000000..2b4910b8be
--- /dev/null
+++ b/include/swift/Nixpkgs/Hardening.h
@@ -0,0 +1,36 @@ extern std::pair<std::vector<std::string>, std::vector<std::string>> getClangImp
+// SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
+#pragma once
+
+#include "llvm/TargetParser/Triple.h"
+
+#include <iterator>
+#include <string>
+#include <vector>
+
+extern std::pair<std::vector<std::string>, std::vector<std::string>> getClangImporterHardeningFlagsForTarget(const llvm::Triple& triple,
+                                                                                                             bool isCC1);
+
+template<typename T>
+void addHardeningFlagsForTarget(std::vector<T> &invocationArgStrs,
+                                const llvm::Triple& triple,
+                                bool skipFirstArgument = false,
+                                bool isCC1 = false) {
+  auto [hardeningFlagsBefore, hardeningFlagsAfter] = getClangImporterHardeningFlagsForTarget(triple, isCC1);
+
+  invocationArgStrs.reserve(invocationArgStrs.size() + hardeningFlagsBefore.size() + hardeningFlagsAfter.size());
+
+  std::vector<T> hardeningFlagsBeforeT;
+  hardeningFlagsBeforeT.reserve(hardeningFlagsBefore.size());
+  for (const auto& flag : hardeningFlagsBefore) {
+    hardeningFlagsBeforeT.emplace_back(flag.c_str());
+  }
+  // Sometimes the first item is `clang` or `-cc1`. Sometimes we need to keep it where it is.
+  invocationArgStrs.insert(
+    next(begin(invocationArgStrs), skipFirstArgument ? 1 : 0),
+    begin(hardeningFlagsBeforeT), end(hardeningFlagsBeforeT)
+  );
+
+  for (const auto& flag : hardeningFlagsAfter) {
+    invocationArgStrs.emplace_back(flag.c_str());
+  }
+}
